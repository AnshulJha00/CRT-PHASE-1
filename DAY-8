#include <iostream> 
using namespace std;



// Problem - 2 
// Encapsulation 


#include <iostream>
using namespace std;

class bankAccount{
    private :
    int bankBalance;
    public:
    void setBalance (int amount){
        if(amount > 0){
            bankBalance = amount;
        } else {
            cout << "Enter the valid amount";
        }
    }
    
    int getBalance(){
        return bankBalance;
    }
};

int main(){
    bankAccount obj1;
    obj1.setBalance(23000);
    cout<< obj1.getBalance();
}

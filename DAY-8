// 1. Inheritance 
// 1.1 Single Inheritance
class Vehicle {
    public:
    void start(){
        cout << "Vehicle  Starts" << "\n";
    }
};
class Car : public Vehicle {
    public:
    void drive(){
        cout<< "Car is running"<< "\n";
    }
};

int main()
{
    Car obj1;
   
  obj1.start();
  obj1.drive();

    return 0;
}


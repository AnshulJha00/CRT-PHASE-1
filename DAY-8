#include <iostream>
using namespace std;

//  1.3 Hierarchical Inheritance


class Vehicle {
    public:
    void start(){
        cout<< "Vehicle Start" << "\n";
    }
};

class Bike : public Vehicle {
    void drive(){
        cout<<"Bike is running..." << "\n";
    }
};

class Car : public Vehicle{
    void drive(){
        cout << "Car is running.." << "\n";
    }
};
int main(){
    Car c; 
    Bike b;
    c.start();
    c.drive();
    b.start();
    b.drive();
}


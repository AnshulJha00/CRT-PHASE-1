// 1.2 Multi-level Inheritance 

class Vehicle {
    public:
    void start(){
        cout << "Vehicle  Starts" << "\n";
    }
};
class Car : public Vehicle {
    public:
    void drive(){
        cout<< "Car is running"<< "\n";
    }
};
 class SpeedOMeter : public Car {
     public :
     void speed(){
          cout << "Car is running at 60km/h"<<"\n";
     }
 };
int main()
{
    SpeedOMeter obj1;
    obj1.start();
    obj1.drive();
    obj1.speed();
   

    return 0;
}


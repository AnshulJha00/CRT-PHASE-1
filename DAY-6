//  Problem --3 
// Smart AC system 
// AC turn temperature automatically 22°C 
// manually change the temperature 
// Eco mode temperature should be 24°C 
// Turbo mode temperature 18° C

#include <iostream>

using namespace std;

void setTemperature(){
    cout<<"Temperature set to 22° C"<<"\n";
}
void setTemperature(double temp){
    cout << "Temperature set to "<< temp << "°C" << "\n";
}
void setTemperature(string mode){
    if(mode == "ECO"){
        cout<< "Temperature set to 24°C";
    } else if (mode == "TURBO"){
        cout<< "Temperature set to 18°C";
    }
}

int main (){
     setTemperature();
     setTemperature(22.5);
     setTemperature("TURBO");
}


// IVR System Customer support 
// 1 --- for support
// 2 ---- for biling 
// 3 ----- for technical issue
// 4 ------ talk to agent


#include <iostream>
 using namespace std;
 
 int main(){
     
     int choice;
     cin>>choice;
     switch(choice){
         
         case 1:
         cout<<"Transfering call to the support...";
         break;
         
         case 2:
         cout<<"Transfering call to the biling and account team...";
         break;
         
         
         case 3:
         cout<<"connecting call to the technical Team...";
         break;
         
         case 4:
         cout<<"Please wait while we are coonecting your call to our agent...";

         break;
         
         default:
         cout<<"Enter a valid choice";
         
     }
     
     return 0;
 }

